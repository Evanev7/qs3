ninja_required_version = 1.10

qstriton = ../build_tools/.venv/bin/qstriton
qscute = ../build_tools/.venv/bin/qscute
qscute_runtime = ../build_tools/.venv/bin/qscute-runtime

build config_inputs: phony ../models/config.nix $
    ../models/gdn_prefill.nix $
    ../models/qwen3.6-35b-a3b/model.json $
    ../models/qwen3.6-27b/model.json $
    ../models/qwen3.8-27b/model.json

rule nix_eval
  command = nix eval --offline --raw --file $in > $out
  description = NIX EVAL $out

rule regenerate
  command = cp ../build_tools/build.ninja build.ninja && cp ../build_tools/cuda.ninja cuda.ninja
  generator = 1
  description = REGENERATE

build constants.rs: nix_eval ../build_tools/nixsrc/rust.nix | config_inputs
build vectors/config.json: nix_eval ../build_tools/nixsrc/vectors.nix | config_inputs
build qsfi_macros.h: nix_eval ../build_tools/nixsrc/c.nix | config_inputs
build triton/kernels.ninja: nix_eval ../build_tools/nixsrc/ninja.nix | config_inputs
build cute/kernels.ninja: nix_eval ../build_tools/nixsrc/cute.nix | config_inputs

build build.ninja cuda.ninja: regenerate | $
    ../build_tools/build.ninja ../build_tools/cuda.ninja triton/kernels.ninja cute/kernels.ninja

subninja cuda.ninja
subninja triton/kernels.ninja
subninja cute/kernels.ninja

build all: phony libqs_native.a triton/kernels cute/kernels libqscute.a libcuda_dialect_runtime_static.a constants.rs
default all
