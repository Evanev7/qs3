ninja_required_version = 1.10

qstriton = ../build_tools/.venv/bin/qstriton

rule regenerate
  command = nix eval --offline --raw --file ../build_tools/nixsrc/ninja.nix > triton/kernels.ninja && $
    cp ../build_tools/build.ninja build.ninja && cp ../build_tools/cuda.ninja cuda.ninja
  generator = 1
  description = REGENERATE

build build.ninja cuda.ninja triton/kernels.ninja: regenerate | $
    ../build_tools/build.ninja ../build_tools/cuda.ninja $
    ../build_tools/nixsrc/ninja.nix $
    ../models/config.nix $
    ../models/qwen3.6-35b-a3b/model.json ../models/qwen3.6-35b-a3b/source.nix $
    ../models/qwen3.6-27b/model.json ../models/qwen3.6-27b/source.nix

subninja cuda.ninja
subninja triton/kernels.ninja

build all: phony libqs_native.a triton/kernels
default all
