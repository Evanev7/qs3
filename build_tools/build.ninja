ninja_required_version = 1.10

qstriton = ../build_tools/.venv/bin/qstriton

build config_inputs: phony ../models/config.nix $
    ../models/qwen3.6-35b-a3b/model.json ../models/qwen3.6-35b-a3b/source.nix $
    ../models/qwen3.6-27b/model.json ../models/qwen3.6-27b/source.nix $
    ../models/qwen3.8-27b/model.json ../models/qwen3.8-27b/source.nix

rule nix_eval
  command = nix eval --offline --raw --file $in > $out
  description = NIX EVAL $out

rule regenerate
  command = cp ../build_tools/build.ninja build.ninja && cp ../build_tools/cuda.ninja cuda.ninja
  generator = 1
  description = REGENERATE

build constants.rs: nix_eval ../build_tools/nixsrc/rust.nix | config_inputs
build triton/kernels.ninja: nix_eval ../build_tools/nixsrc/ninja.nix | config_inputs

build build.ninja cuda.ninja: regenerate | $
    ../build_tools/build.ninja ../build_tools/cuda.ninja triton/kernels.ninja

subninja cuda.ninja
subninja triton/kernels.ninja

build all: phony libqs_native.a triton/kernels constants.rs
default all
