cuda_root := env_var_or_default("CUDA_HOME", "/usr/local/cuda")
cuda_lib_path := cuda_root + "/lib64:" + cuda_root + "/lib:"
qwen36_vectors := ".venv/bin/qwen36-vectors"

fmt:
        .venv/bin/ruff format . ../triton_kernels

check:
        .venv/bin/ruff check --fix . ../triton_kernels
        .venv/bin/ty check --project . . ../triton_kernels

uv-sync:
        uv sync --locked

generate-vectors:
        just --justfile ../justfile ninja
        ninja -C ../build vectors/qwen36_semantics/.oracle-ok

refresh-vector-oracles:
        {{qwen36_vectors}} generate-all --output-root ../build/vectors/qwen36_semantics --clean
        {{qwen36_vectors}} write-oracles --input-root ../build/vectors/qwen36_semantics --oracle-root pysrc/qwen36_vectors/oracle_hashes

unit-test:
        .venv/bin/python -m pytest tests

python-test: check unit-test
        .venv/bin/ruff format --check . ../triton_kernels
        {{qwen36_vectors}} generate-all --output-root ../build/vectors/python-test --clean
        {{qwen36_vectors}} check-oracles --input-root ../build/vectors/python-test

triton-test:
        mkdir -p ../build/triton-test
        nix eval --json --file ../models/config.nix > ../build/triton-test/config.json
        LIBRARY_PATH="{{cuda_lib_path}}:${LIBRARY_PATH:-}" .venv/bin/python pysrc/qstriton/test.py ../build/triton-test/config.json
