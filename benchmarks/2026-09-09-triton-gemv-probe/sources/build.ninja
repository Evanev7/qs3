# Run from repository root after just uv-sync.
python = build_tools/.venv/bin/python
nvcc = nvcc
probe = .prototypes/gemv_aot
artifacts = .prototypes/gemv_aot/out

rule aot
  command = $python $probe/compile.py --out $artifacts
  description = AOT Qwen GEMV SM121

rule native
  command = $nvcc -std=c++17 -O3 -arch=sm_121 -I. -I$artifacts -DQSFI_ENABLE_CHECKED_VALIDATION=1 $probe/bench.cu qscb.cu -lcuda -lcublasLt -o $artifacts/probe
  description = BUILD GEMV probe

build $artifacts/kernels.h $artifacts/manifest.json $
  $artifacts/qkv_r1_w4.cubin $artifacts/qkv_r1_w4.ptx $
  $artifacts/qkv_r4_w4.cubin $artifacts/qkv_r4_w4.ptx $
  $artifacts/qkv_r8_w8.cubin $artifacts/qkv_r8_w8.ptx $
  $artifacts/z_r1_w4.cubin $artifacts/z_r1_w4.ptx $
  $artifacts/z_r4_w4.cubin $artifacts/z_r4_w4.ptx $
  $artifacts/z_r8_w8.cubin $artifacts/z_r8_w8.ptx $
  $artifacts/out_r1_w4.cubin $artifacts/out_r1_w4.ptx $
  $artifacts/out_r4_w4.cubin $artifacts/out_r4_w4.ptx $
  $artifacts/out_r8_w8.cubin $artifacts/out_r8_w8.ptx $
  $artifacts/lm_head_r1_w4.cubin $artifacts/lm_head_r1_w4.ptx $
  $artifacts/lm_head_r4_w4.cubin $artifacts/lm_head_r4_w4.ptx $
  $artifacts/lm_head_r8_w8.cubin $artifacts/lm_head_r8_w8.ptx: aot $probe/kernel.py $probe/compile.py build_tools/uv.lock build_tools/pyproject.toml
build $artifacts/probe: native $probe/bench.cu qscb.cu qscb.h qs_tensor.h qs_info.h qsfi_native_common.h | $artifacts/kernels.h
default $artifacts/probe
